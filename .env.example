# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is git-ignored. Never commit it, and never put a real key in this file.

# Required. Generate your own with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True for local development. Leave False (or unset) anywhere public.
DJANGO_DEBUG=True

# Comma-separated hostnames the site may be served from.
# Can stay empty for local development while DJANGO_DEBUG is True.
DJANGO_ALLOWED_HOSTS=
